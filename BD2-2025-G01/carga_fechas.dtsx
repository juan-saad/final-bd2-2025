  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Crear tabla dim_fecha"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1EAB5A95-9850-43CA-B243-2DB67B2DB0CF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Crear tabla dim_fecha"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CDD9B5C9-3876-442B-880A-133750C219D7}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'dim_fecha_G01' AND schema_id = SCHEMA_ID('dbo'))&#xA;BEGIN&#xA;    -- Crear la tabla de dimensiones de fecha&#xA;    CREATE TABLE dbo.dim_fecha_G01 (&#xA;        fecha_key INT PRIMARY KEY,&#xA;        fecha DATE NOT NULL,&#xA;        anio INT,&#xA;        trimestre INT,&#xA;        mes INT,&#xA;        nombre_mes NVARCHAR(20),&#xA;        dia INT,&#xA;        dia_semana INT,&#xA;        nombre_dia_semana NVARCHAR(20),&#xA;        es_fin_de_semana BIT,&#xA;        es_feriado BIT DEFAULT 0&#xA;    );&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Popular datos de dim_fecha"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{481DBEC0-D0B0-4249-A6FD-21C77136C798}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Popular datos de dim_fecha"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CDD9B5C9-3876-442B-880A-133750C219D7}"
          SQLTask:SqlStatementSource="DECLARE @fechaInicio DATE = '2000-01-01';&#xA;DECLARE @fechaFin DATE = '2030-12-31';&#xA;&#xA;WHILE @fechaInicio &lt;= @fechaFin&#xA;BEGIN&#xA;    INSERT INTO dim_fecha_G01 (&#xA;        fecha_key,&#xA;        fecha,&#xA;        anio,&#xA;        trimestre,&#xA;        mes,&#xA;        nombre_mes,&#xA;        dia,&#xA;        dia_semana,&#xA;        nombre_dia_semana,&#xA;        es_fin_de_semana&#xA;    )&#xA;    VALUES (&#xA;        CONVERT(INT, FORMAT(@fechaInicio, 'yyyyMMdd')),&#xA;        @fechaInicio,&#xA;        YEAR(@fechaInicio),&#xA;        DATEPART(QUARTER, @fechaInicio),&#xA;        MONTH(@fechaInicio),&#xA;        DATENAME(MONTH, @fechaInicio),&#xA;        DAY(@fechaInicio),&#xA;        DATEPART(WEEKDAY, @fechaInicio),&#xA;        DATENAME(WEEKDAY, @fechaInicio),&#xA;        CASE WHEN DATENAME(WEEKDAY, @fechaInicio) IN ('Saturday', 'Sunday') THEN 1 ELSE 0 END&#xA;    );&#xA;&#xA;    SET @fechaInicio = DATEADD(DAY, 1, @fechaInicio);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
