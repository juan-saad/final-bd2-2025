                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 	[EMPLOYEE_ID]
      , UPPER(TRIM([FULL_NAME])) AS FULL_NAME
      , UPPER(TRIM([CATEGORY])) AS CATEGORY
      , CONVERT(DATE, [EMPLOYMENT_DATE]) AS EMPLOYMENT_DATE
      , CONVERT(DATE, [BIRTH_DATE]) AS BIRTH_DATE
      , UPPER(TRIM([EDUCATION_LEVEL])) AS EDUCATION_LEVEL
      , UPPER(TRIM([GENDER])) AS GENDER
FROM [bd_staging_2025_G01].[dbo].[stg_empleados_G01] e
WHERE e.EMPLOYEE_ID IS NOT NULL</property>
