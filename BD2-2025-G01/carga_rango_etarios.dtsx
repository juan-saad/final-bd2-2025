      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CDD9B5C9-3876-442B-880A-133750C219D7}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1 FROM sys.tables WHERE name = 'dim_rango_etario_G01' AND schema_id = SCHEMA_ID('dbo')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE dbo.dim_rango_etario_G01 (&#xA;        rango_etario_key INT PRIMARY KEY IDENTITY(1,1),&#xA;        descripcion NVARCHAR(50),&#xA;        edad_desde INT,&#xA;        edad_hasta INT&#xA;    );&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
