      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Populate table dim_rango_etario"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CDD9B5C9-3876-442B-880A-133750C219D7}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.dim_rango_etario_G01 (descripcion, edad_desde, edad_hasta)&#xA;    VALUES &#xA;        ('Teenagers (13-19)', 13, 19),&#xA;        ('Adultos medios (40-50)', 40, 50),&#xA;        ('Mismo rango que el gerente (66 años)', 66, 66);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
