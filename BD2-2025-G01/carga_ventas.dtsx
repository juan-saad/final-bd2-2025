          SQLTask:Connection="{CDD9B5C9-3876-442B-880A-133750C219D7}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'fact_venta_G01' AND schema_id = SCHEMA_ID('dbo'))&#xA;BEGIN&#xA;&#x9;CREATE TABLE fact_venta_G01(&#xA;&#x9;&#x9;[cliente_key] INT,&#xA;&#x9;&#x9;[employee_key] INT,&#xA;&#x9;&#x9;[product_key] INT,&#xA;&#x9;&#x9;[region_key] INT,&#xA;&#x9;&#x9;[vacaciones_key] INT,&#xA;&#x9;&#x9;[fecha_key] INT,&#xA;&#x9;&#x9;[venta_id] INT NOT NULL,&#xA;&#x9;&#x9;[fecha_venta] DATETIME NULL,&#xA;&#x9;&#x9;[cliente_id] INT NULL,&#xA;&#x9;&#x9;[edad_cliente] INT NULL,&#xA;&#x9;&#x9;[empleado_id] INT NULL,&#xA;&#x9;&#x9;[edad_empleado] INT NULL,&#xA;&#x9;&#x9;[producto_id] INT NULL,&#xA;&#x9;&#x9;[cantidad] INT NULL,&#xA;&#x9;&#x9;[region] VARCHAR(50) NULL,&#xA;&#x9;&#x9;[total_facturado] DECIMAL(10, 2) NULL,&#xA;&#x9;&#x9;[total_facturado_con_descuento] DECIMAL(10, 2) NULL,&#xA;&#x9;&#x9;[precio] DECIMAL(10, 2) NULL,&#xA;&#x9;&#x9;[descuento] DECIMAL(5, 2) NULL,&#xA;&#x9;&#x9;[litros_por_unidad] DECIMAL(10, 2) NULL,&#xA;&#x9;&#x9;[total_litros] DECIMAL(10, 2) NULL,&#xA;&#x9;&#xA;&#x9;&#x9;-- FKs&#xA;&#x9;&#x9;FOREIGN KEY (cliente_key) REFERENCES [datawarehouse_2025_G01].[dbo].[dim_clientes_G01] (clientes_key),&#xA;&#x9;&#x9;FOREIGN KEY (employee_key) REFERENCES [datawarehouse_2025_G01].[dbo].[dim_empleados_G01] (employee_key),&#xA;&#x9;&#x9;FOREIGN KEY (product_key) REFERENCES [datawarehouse_2025_G01].[dbo].[dim_productos_G01] (product_key),&#xA;&#x9;&#x9;FOREIGN KEY (region_key) REFERENCES [datawarehouse_2025_G01].[dbo].[dim_region_G01] (region_key),&#xA;&#x9;&#x9;FOREIGN KEY (vacaciones_key) REFERENCES [datawarehouse_2025_G01].[dbo].[dim_vacaciones_G01] (vacaciones_key),&#xA;&#x9;&#x9;FOREIGN KEY (fecha_key) REFERENCES [datawarehouse_2025_G01].[dbo].[dim_fecha_G01] (fecha_key),&#xA;&#xA;&#x9;&#x9;-- PK Compuesta de la fact&#xA;&#x9;&#x9;PRIMARY KEY (product_key, venta_id)&#xA;&#x9;)&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
