	ventas.total_facturado_con_descuento,
	ventas.precio,
	ventas.descuento,
	ventas.litros_por_unidad,
	ventas.total_litros
from [bd_intermedia_2025_G01].[dbo].int_ventas_G01 ventas with(nolock)
inner join [datawarehouse_2025_G01].[dbo].dim_clientes_G01 clientes with(nolock) on ventas.CLIENTE_ID = clientes.customer_id
inner join [datawarehouse_2025_G01].[dbo].dim_empleados_G01 empleados with(nolock) on ventas.EMPLEADO_ID = empleados.employee_id
inner join [datawarehouse_2025_G01].[dbo].dim_productos_G01 productos with(nolock) on ventas.PRODUCTO_ID = productos.product_id</property>
