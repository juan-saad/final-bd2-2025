            </component>
            <component
              refId="Package\Carga intermedia ventas\Source ventas_descuentos_precio_total"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Source ventas_descuentos_precio_total"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[stg_detalle_ventas_G01]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">with
    TMP_Fact
    as
    (
            SELECT
                t1.BILLING_ID,
                MAX(t1.DATE) DATE,
                MAX(t1.CUSTOMER_ID) CUSTOMER_ID,
                MAX(t1.EMPLOYEE_ID) EMPLOYEE_ID,
                t2.PRODUCT_ID,
                SUM(t2.QUANTITY) QUANTITY,
                MAX(t1.REGION) REGION
            FROM [bd_staging_2025_G01].[dbo].[stg_ventas_G01] as t1
                INNER JOIN [bd_staging_2025_G01].dbo.[stg_detalle_ventas_G01] as t2 on t1.BILLING_ID = t2.BILLING_ID
            GROUP BY t1.BILLING_ID,
                t2.PRODUCT_ID

        UNION ALL

            SELECT
                t1.BILLING_ID,
                MAX(t1.DATE) DATE,
                MAX(t1.CUSTOMER_ID),
                MAX(t1.EMPLOYEE_ID),
                t1.PRODUCT_ID,
                SUM(t1.QUANTITY) QUANTITY,
                MAX(t1.REGION)
            FROM [bd_staging_2025_G01].[dbo].[stg_ventas_hist_G01] t1
            GROUP BY t1.BILLING_ID,
                t1.PRODUCT_ID
    ),
    TMP_Precios
    as
    (
        SELECT t1.PRODUCT_ID
        , t1.DATE
        , LEAD(DATE, 1) OVER (PARTITION BY PRODUCT_ID ORDER BY DATE) AS [UNTIL]
        , t1.PRICE
        FROM [bd_staging_2025_G01].[dbo].[stg_precios_G01] t1
    ),
    CTE_Total_Facturado
    AS
    (
        select v.billing_id, v.date, SUM(v.quantity) * SUM(p.PRICE) AS total_facturado
        from TMP_Fact v
            left join TMP_Precios p
            on v.product_id = p.PRODUCT_ID
                and v.date &gt;= p.[DATE]
                and (v.date &lt; p.UNTIL or p.UNTIL is null)
        group by v.billing_id, v.date
    ),
    CTE_Descuentos
    AS
    (
        select v.billing_id, v.date, v.total_facturado, isnull(MAX(d.PERCENTAGE/100.00),0.00) AS descuento
        from CTE_Total_Facturado v --1656457
            left join [bd_staging_2025_G01].[dbo].[stg_descuentos_G01] d
            on v.date &gt;= d.[FROM]
                and (v.date &lt; d.UNTIL or d.UNTIL is null)
                and v.total_facturado &gt; d.TOTAL_BILLING
        group by v.billing_id, v.date, v.total_facturado
    )
select
    v.BILLING_ID AS [VENTA_ID]
    , v.DATE AS [FECHA_VENTA]
    , v.CUSTOMER_ID AS [CLIENTE_ID]
    , DATEDIFF(YEAR, cli.BIRTH_DATE, v.DATE) - 
    CASE 
        WHEN DATEADD(YEAR, DATEDIFF(YEAR, cli.BIRTH_DATE, v.DATE), cli.BIRTH_DATE) &gt; v.DATE 
        THEN 1 
        ELSE 0 
    END AS [EDAD_CLIENTE]
  , v.EMPLOYEE_ID AS [EMPLEADO_ID]
  , DATEDIFF(YEAR, emp.BIRTH_DATE, v.DATE) - 
    CASE 
        WHEN DATEADD(YEAR, DATEDIFF(YEAR, emp.BIRTH_DATE, v.DATE), emp.BIRTH_DATE) &gt; v.DATE 
        THEN 1 
        ELSE 0 
    END AS [EDAD_EMPLEADO]
  , v.PRODUCT_ID AS [PRODUCTO_ID]
  , v.QUANTITY AS [CANTIDAD]
  , v.REGION AS [REGION]
  , v.quantity * prec.PRICE AS [TOTAL_FACTURADO]
  , v.quantity * prec.PRICE * (1-d.descuento)  AS [TOTAL_FACTURADO_CON_DESCUENTO]
  , prec.PRICE AS [PRECIO]
  , d.descuento AS [DESCUENTO]
  , prod.AMOUNT_LITER AS [LITROS_POR_UNIDAD]
  , v.quantity * prod.AMOUNT_LITER AS [TOTAL_LITROS]
from TMP_Fact v
    INNER JOIN [bd_intermedia_2025_G01].[dbo].[int_productos_G01] prod ON prod.PRODUCT_ID = v.PRODUCT_ID
    INNER JOIN [bd_intermedia_2025_G01].[dbo].[int_clientes_G01] cli ON cli.CUSTOMER_ID = v.CUSTOMER_ID
    INNER JOIN [bd_intermedia_2025_G01].[dbo].[int_empleados_G01] emp ON emp.EMPLOYEE_ID = v.EMPLOYEE_ID
    left join TMP_Precios prec
    on v.product_id = prec.PRODUCT_ID
        and v.date &gt;= prec.[DATE]
        and (v.date &lt; prec.UNTIL or prec.UNTIL is null)
    left join CTE_Descuentos d
    on v.billing_id = d.billing_id
ORDER BY v.BILLING_ID</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
