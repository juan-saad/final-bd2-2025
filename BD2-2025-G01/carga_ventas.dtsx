                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select
	clientes.clientes_key,
	empleados.employee_key,
	productos.product_key,
	CAST(CONVERT(CHAR(8), FECHA_VENTA, 112) AS INT) AS fecha_key,
	ventas.VENTA_ID venta_id,
	ventas.FECHA_VENTA fecha_venta,
	ventas.cliente_id,
	ventas.edad_cliente,
	ventas.empleado_id,
	ventas.edad_empleado,
	ventas.producto_id,
	ventas.cantidad,
	ventas.region,
