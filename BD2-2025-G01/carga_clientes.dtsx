                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    cr.CUSTOMER_ID,
    cr.FULL_NAME,
    CASE 
        WHEN TRY_CONVERT(DATE, cr.BIRTH_DATE) IS NOT NULL THEN TRY_CONVERT(DATE, cr.BIRTH_DATE)
        WHEN TRY_CONVERT(DATE, REPLACE(cr.BIRTH_DATE, '*', '')) IS NOT NULL THEN TRY_CONVERT(DATE, REPLACE(cr.BIRTH_DATE, '*', ''))
        ELSE NULL
    END AS BIRTH_DATE,
    cr.CITY,
    cr.STATE,
    cr.ZIPCODE
FROM [bd_staging_2025_G01].dbo.[stg_clientes_r_G01] cr
ORDER BY cr.CUSTOMER_ID;</property>
